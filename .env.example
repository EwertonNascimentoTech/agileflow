# ── APP ──────────────────────────────────────
PROJECT_NAME="Kore SaaS"
# true só em desenvolvimento: liga /docs, /redoc e /openapi.json. Produção = false.
DEBUG=true
SECRET_KEY=troque-por-uma-chave-secreta-forte-de-32-chars

# Origens permitidas (separar por vírgula se necessário)
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── JWT ──────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── DATABASE ─────────────────────────────────
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=saas_pass
POSTGRES_DB=saas_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── REDIS ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RABBITMQ ─────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ── MINIO ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DEFAULT=saas-storage
MINIO_SECURE=false
# Host das URLs de download no browser (sem https://). Vazio = MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=agileflow.tdsistemafiea.com.br
MINIO_PUBLIC_SECURE=true
MINIO_REGION=us-east-1

# ── IDCortex Gateway (agentes por etapa) ─────
IDCORTEX_GATEWAY_URL=https://idcortex-dev.sistemafiea.com.br/gateway/ask
IDCORTEX_CLIENT_ID=
IDCORTEX_CLIENT_SECRET=

# Azure DevOps — commits dos repositórios vinculados aos produtos
# PAT com escopo Code (Read). Vazio = integração inerte (job no-op).
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/processostotecnologia
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_API_VERSION=7.1
AZURE_DEVOPS_BACKFILL_DAYS=365
AZURE_DEVOPS_WEBHOOK_USER=
AZURE_DEVOPS_WEBHOOK_SECRET=
AZURE_DEVOPS_BOT_EMAIL_PATTERNS=noreply,azuredevops,build@,pipeline,bot@,@bot

# SSO IDigital (OIDC) — botão "Entre com o IDigital" ao lado do login por senha.
# Desligado até o client existir no IdP. Ver docs/técnico/09-sso-idigital.md.
SSO_ENABLED=false
SSO_AUTHORITY=https://sso.idigital.sistemafiea.com.br/sso/oidc
SSO_CLIENT_ID=
SSO_RESOURCE=
SSO_SCOPE=openid email profile
# Quem entra pelo IDigital sem login e fora de Pessoas vira cliente do Portal neste tenant (slug).
SSO_CLIENT_TENANT=ss

# EPA (Sistema de Planos de Ação) — integração do RTD (Planos Estratégicos)
EPA_API_BASE_URL=https://sistemafiea.sysepa.com.br
EPA_LOGIN=
EPA_SENHA=
EPA_PLANOS_ESTRATEGICO=
EPA_PLANOS_TATICOS=

# Pasta docs/ (Markdown utilizador/processo/técnico). Vazio = auto-detect.
# No Docker Compose já monta ./docs em /docs e define DOCS_ROOT=/docs.
DOCS_ROOT=

# Portfólio de produtos — endpoint público (token fixo).
# GET /api/v1/public/produtos/portfolio/{token}
PUBLIC_PRODUTOS_PORTFOLIO_TOKEN=
PUBLIC_PRODUTOS_TENANT_SLUG=ss

# Ociosidade diária — endpoint público (token fixo).
# GET /api/v1/public/projetos/ociosidade/{token}
PUBLIC_OCIOSIDADE_TOKEN=
PUBLIC_OCIOSIDADE_TENANT_SLUG=ss
