# ── APP ──────────────────────────────────────
PROJECT_NAME="Kore SaaS"
DEBUG=true
SECRET_KEY=troque-por-uma-chave-secreta-forte-de-32-chars

# Origens permitidas (separar por vírgula se necessário)
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── JWT ──────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── DATABASE ─────────────────────────────────
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=saas_pass
POSTGRES_DB=saas_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── REDIS ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RABBITMQ ─────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ── MINIO ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DEFAULT=saas-storage
MINIO_SECURE=false
