             exporterVersion="1.0">

  <!--
    BPMN � Fluxo das etapas com bifurca??es
    Kanbans: Prospectar Solu??es | Projetos e Programas | Contratar
    Fonte: etapas reais do tenant (processo TD) + regra de contrata??o.
  -->

  <collaboration id="Collab_Kanbans">
    <participant id="Part_Prospectar" name="Kanban: Prospectar Solu??es" processRef="Proc_Prospectar"/>
    <participant id="Part_Projetos" name="Kanban: Projetos e Programas" processRef="Proc_Projetos"/>
    <participant id="Part_Contratar" name="Kanban: Contratar" processRef="Proc_Contratar"/>

    <!-- Handoff Prospectar conclu?do ? cria card em Projetos/Programas -->
    <messageFlow id="MF_Prospectar_to_Projetos"
                 name="Convers?o: cria Projeto/Programa"
                 sourceRef="Task_P_Concluido"
                 targetRef="Task_J_Backlog"/>

    <!-- Bifurca??o contrata??o: origem fica em Contrata??o; nasce card Contratar -->
    <messageFlow id="MF_Origem_to_Contratar"
                 name="Ser? contratado? = Sim ? cria card Contratar"
                 sourceRef="Task_Hold_Contrata??o"
                 targetRef="Task_C_Backlog"/>

    <!-- Desfecho Contratar ? libera ou cancela origem -->
    <messageFlow id="MF_Contratar_Win"
                 name="Ganhou: contrato no Produto + libera origem"
                 sourceRef="Task_C_Concluido"
                 targetRef="Gateway_PosHold"/>
    <messageFlow id="MF_Contratar_Lose"
                 name="Perdeu: origem ? Cancelado"
                 sourceRef="Task_C_Cancelado"
                 targetRef="Task_Origem_Cancelado"/>
  </collaboration>

  <!-- ???????????????????????????????????????????
       PROSPECTAR SOLU??ES
       ??????????????????????????????????????????? -->
  <process id="Proc_Prospectar" name="Prospectar Solu??es" isExecutable="false">
    <startEvent id="Start_Prospectar" name="Nova demanda"/>
    <sequenceFlow id="SF_P01" sourceRef="Start_Prospectar" targetRef="Task_P_Backlog"/>

    <userTask id="Task_P_Backlog" name="Backlog"/>
    <sequenceFlow id="SF_P02" sourceRef="Task_P_Backlog" targetRef="Gateway_Classificar"/>

    <exclusiveGateway id="Gateway_Classificar" name="Classificar card"/>
    <sequenceFlow id="SF_P03" name="Desenvolvimento" sourceRef="Gateway_Classificar" targetRef="Task_P_Classificacao"/>
    <sequenceFlow id="SF_P04" name="Implanta??o / Melhoria" sourceRef="Gateway_Classificar" targetRef="Gateway_Externo"/>

    <exclusiveGateway id="Gateway_Externo" name="Produto sistema externo?"/>
    <sequenceFlow id="SF_P05" name="N?o" sourceRef="Gateway_Externo" targetRef="Task_P_Classificacao"/>
    <sequenceFlow id="SF_P06" name="Sim" sourceRef="Gateway_Externo" targetRef="Gateway_SeraContratado"/>

    <exclusiveGateway id="Gateway_SeraContratado" name="Ser? contratado?"/>
    <sequenceFlow id="SF_P07" name="N?o" sourceRef="Gateway_SeraContratado" targetRef="Task_P_Classificacao"/>
    <sequenceFlow id="SF_P08" name="Sim" sourceRef="Gateway_SeraContratado" targetRef="Task_Hold_Contrata??o"/>

    <!-- Origem travada na raia Contrata??o (pode estar em Prospectar ou Projetos) -->
    <userTask id="Task_Hold_Contrata??o" name="Contrata??o (origem travada)"/>
    <sequenceFlow id="SF_P09" sourceRef="Task_Hold_Contrata??o" targetRef="Gateway_PosHold"/>

    <exclusiveGateway id="Gateway_PosHold" name="Desfecho da contrata??o"/>
    <sequenceFlow id="SF_P10" name="Ganhou ? segue fluxo" sourceRef="Gateway_PosHold" targetRef="Task_P_Classificacao"/>
    <sequenceFlow id="SF_P11" name="Perdeu" sourceRef="Gateway_PosHold" targetRef="Task_Origem_Cancelado"/>

    <userTask id="Task_Origem_Cancelado" name="Cancelado (origem)"/>
    <sequenceFlow id="SF_P12" sourceRef="Task_Origem_Cancelado" targetRef="End_P_Cancelado"/>
    <endEvent id="End_P_Cancelado" name="Demanda cancelada"/>

    <userTask id="Task_P_Classificacao" name="Classifica??o"/>
    <sequenceFlow id="SF_P13" sourceRef="Task_P_Classificacao" targetRef="Task_P_Avaliar"/>

    <userTask id="Task_P_Avaliar" name="Avaliar Classifica??o"/>
    <sequenceFlow id="SF_P14" sourceRef="Task_P_Avaliar" targetRef="Gateway_Avaliacao"/>

    <exclusiveGateway id="Gateway_Avaliacao" name="Resultado da avalia??o"/>
    <sequenceFlow id="SF_P15" name="Ajustes" sourceRef="Gateway_Avaliacao" targetRef="Task_P_Ajustes"/>
    <sequenceFlow id="SF_P16" name="Impedimento" sourceRef="Gateway_Avaliacao" targetRef="Task_P_Impedimento"/>
    <sequenceFlow id="SF_P17" name="Rejeitado" sourceRef="Gateway_Avaliacao" targetRef="Task_P_Rejeitado"/>
    <sequenceFlow id="SF_P18" name="Aprovado" sourceRef="Gateway_Avaliacao" targetRef="Task_P_Concluido"/>

    <userTask id="Task_P_Ajustes" name="Ajustes"/>
    <sequenceFlow id="SF_P19" sourceRef="Task_P_Ajustes" targetRef="Task_P_Avaliar"/>

    <userTask id="Task_P_Impedimento" name="Impedimento"/>
    <sequenceFlow id="SF_P20" sourceRef="Task_P_Impedimento" targetRef="Task_P_Avaliar"/>

    <userTask id="Task_P_Rejeitado" name="Rejeitado"/>
    <sequenceFlow id="SF_P21" sourceRef="Task_P_Rejeitado" targetRef="End_P_Rejeitado"/>
    <endEvent id="End_P_Rejeitado" name="Prospec??o rejeitada"/>

    <userTask id="Task_P_Concluido" name="Conclu?do (converte p/ Projeto)"/>
    <sequenceFlow id="SF_P22" sourceRef="Task_P_Concluido" targetRef="End_P_Ok"/>
    <endEvent id="End_P_Ok" name="Handoff para Projetos e Programas"/>
  </process>

  <!-- ???????????????????????????????????????????
       PROJETOS E PROGRAMAS
       ??????????????????????????????????????????? -->
  <process id="Proc_Projetos" name="Projetos e Programas" isExecutable="false">
