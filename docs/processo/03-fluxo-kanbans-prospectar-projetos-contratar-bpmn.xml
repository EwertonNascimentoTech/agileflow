    <userTask id="Task_J_Dev" name="Em Desenvolvimento"/>
    <sequenceFlow id="SF_J19" sourceRef="Task_J_Dev" targetRef="Task_J_DevOps"/>

    <userTask id="Task_J_DevOps" name="DevOps (HML)"/>
    <sequenceFlow id="SF_J20" sourceRef="Task_J_DevOps" targetRef="Task_J_HML"/>

    <userTask id="Task_J_HML" name="Homologando (Cliente)"/>
    <sequenceFlow id="SF_J21" sourceRef="Task_J_HML" targetRef="Gateway_J_HML"/>

    <exclusiveGateway id="Gateway_J_HML" name="Homologa??o ok?"/>
    <sequenceFlow id="SF_J22" name="N?o" sourceRef="Gateway_J_HML" targetRef="Task_J_Dev"/>
    <sequenceFlow id="SF_J23" name="Sim" sourceRef="Gateway_J_HML" targetRef="Task_J_Prod"/>

    <userTask id="Task_J_Prod" name="DEVSECOPS (PROD)"/>
    <sequenceFlow id="SF_J24" sourceRef="Task_J_Prod" targetRef="Task_J_Concluido"/>

    <userTask id="Task_J_Concluido" name="Conclu?do"/>
    <sequenceFlow id="SF_J25" sourceRef="Task_J_Concluido" targetRef="End_J_Ok"/>
    <endEvent id="End_J_Ok" name="Projeto entregue"/>

    <userTask id="Task_J_Cancelado" name="Cancelado"/>
    <sequenceFlow id="SF_J26" sourceRef="Task_J_Cancelado" targetRef="End_J_Cancel"/>
    <endEvent id="End_J_Cancel" name="Projeto cancelado"/>
