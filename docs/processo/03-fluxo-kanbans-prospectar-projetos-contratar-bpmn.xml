    <userTask id="Task_J_Refinamento" name="Refinamento PO e Tech"/>
    <sequenceFlow id="SF_J14" sourceRef="Task_J_Refinamento" targetRef="Task_J_Validar"/>

    <userTask id="Task_J_Validar" name="Validar Escopo (Cliente)"/>
    <sequenceFlow id="SF_J15" sourceRef="Task_J_Validar" targetRef="Gateway_J_Escopo"/>

    <exclusiveGateway id="Gateway_J_Escopo" name="Escopo ok?"/>
    <sequenceFlow id="SF_J16" name="N?o" sourceRef="Gateway_J_Escopo" targetRef="Task_J_Requisitos"/>
