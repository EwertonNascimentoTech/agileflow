<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_AgileFlow"
             targetNamespace="https://agileflow.local/processo"
             exporter="architect-bpm-reverse-engineer"
             exporterVersion="1.0">

  <collaboration id="Collaboration_1">
    <participant id="Participant_Solicitante" name="Solicitante" processRef="Process_Solicitante"/>
    <participant id="Participant_PMO" name="Gestor / PMO" processRef="Process_PMO"/>
    <participant id="Participant_Execucao" name="Equipa de execução" processRef="Process_Execucao"/>
    <participant id="Participant_RTD" name="Facilitador RTD" processRef="Process_RTD"/>
    <messageFlow id="MF_1" sourceRef="Task_Abrir" targetRef="Task_Triagem"/>
    <messageFlow id="MF_2" sourceRef="Task_Aprovar" targetRef="Task_Planear"/>
    <messageFlow id="MF_3" sourceRef="Task_Entregar" targetRef="Task_RTD"/>
  </collaboration>

  <!-- Lane: Solicitante -->
  <process id="Process_Solicitante" name="Solicitante" isExecutable="false">
    <startEvent id="Start_Solicitante" name="Precisa de trabalho"/>
    <sequenceFlow id="SF_S1" sourceRef="Start_Solicitante" targetRef="Task_Abrir"/>
    <userTask id="Task_Abrir" name="Abrir solicitação"/>
    <sequenceFlow id="SF_S2" sourceRef="Task_Abrir" targetRef="Task_Acompanhar"/>
    <userTask id="Task_Acompanhar" name="Acompanhar Minhas Solicitações"/>
    <sequenceFlow id="SF_S3" sourceRef="Task_Acompanhar" targetRef="End_Solicitante"/>
    <endEvent id="End_Solicitante" name="Pedido concluído / informado"/>
  </process>

  <!-- Lane: PMO -->
  <process id="Process_PMO" name="Gestor / PMO" isExecutable="false">
    <startEvent id="Start_PMO" name="Nova demanda no quadro"/>
    <sequenceFlow id="SF_P1" sourceRef="Start_PMO" targetRef="Task_Triagem"/>
    <userTask id="Task_Triagem" name="Triagem no kanban"/>
    <sequenceFlow id="SF_P2" sourceRef="Task_Triagem" targetRef="Gateway_Prio"/>
    <exclusiveGateway id="Gateway_Prio" name="Priorização obrigatória?"/>
    <sequenceFlow id="SF_P3" name="Sim" sourceRef="Gateway_Prio" targetRef="Task_Priorizar"/>
    <sequenceFlow id="SF_P4" name="Não" sourceRef="Gateway_Prio" targetRef="Gateway_Aprovar"/>
    <userTask id="Task_Priorizar" name="Pontuar Impacto × Esforço"/>
    <sequenceFlow id="SF_P5" sourceRef="Task_Priorizar" targetRef="Gateway_Aprovar"/>
    <exclusiveGateway id="Gateway_Aprovar" name="Aprovar conversão?"/>
    <sequenceFlow id="SF_P6" name="Ainda não" sourceRef="Gateway_Aprovar" targetRef="Task_Triagem"/>
    <sequenceFlow id="SF_P7" name="Sim" sourceRef="Gateway_Aprovar" targetRef="Task_Aprovar"/>
    <userTask id="Task_Aprovar" name="Aprovar Projeto ou Programa"/>
    <sequenceFlow id="SF_P8" sourceRef="Task_Aprovar" targetRef="End_PMO"/>
    <endEvent id="End_PMO" name="Item de planejamento criado"/>
  </process>

  <!-- Lane: Execução -->
  <process id="Process_Execucao" name="Equipa de execução" isExecutable="false">
    <startEvent id="Start_Exec" name="Item aprovado"/>
    <sequenceFlow id="SF_E1" sourceRef="Start_Exec" targetRef="Task_Planear"/>
    <userTask id="Task_Planear" name="Definir início e prazo"/>
    <sequenceFlow id="SF_E2" sourceRef="Task_Planear" targetRef="Gateway_Datas"/>
    <exclusiveGateway id="Gateway_Datas" name="Datas obrigatórias ok?"/>
    <sequenceFlow id="SF_E3" name="Não" sourceRef="Gateway_Datas" targetRef="Task_Planear"/>
    <sequenceFlow id="SF_E4" name="Sim" sourceRef="Gateway_Datas" targetRef="Task_Executar"/>
    <userTask id="Task_Executar" name="Executar no kanban"/>
    <sequenceFlow id="SF_E5" sourceRef="Task_Executar" targetRef="Gateway_Final"/>
    <exclusiveGateway id="Gateway_Final" name="Etapa final?"/>
    <sequenceFlow id="SF_E6" name="Não" sourceRef="Gateway_Final" targetRef="Task_Executar"/>
    <sequenceFlow id="SF_E7" name="Sim" sourceRef="Gateway_Final" targetRef="Task_Entregar"/>
    <userTask id="Task_Entregar" name="Entregar e sincronizar origem"/>
    <sequenceFlow id="SF_E8" sourceRef="Task_Entregar" targetRef="End_Exec"/>
    <endEvent id="End_Exec" name="Trabalho entregue"/>
  </process>

  <!-- Lane: RTD opcional -->
  <process id="Process_RTD" name="Facilitador RTD" isExecutable="false">
    <startEvent id="Start_RTD" name="Necessidade de decisão"/>
    <sequenceFlow id="SF_R1" sourceRef="Start_RTD" targetRef="Task_RTD"/>
    <userTask id="Task_RTD" name="Conduzir RTD (indicadores, planos, deliberações)"/>
    <sequenceFlow id="SF_R2" sourceRef="Task_RTD" targetRef="End_RTD"/>
    <endEvent id="End_RTD" name="Reunião encerrada"/>
  </process>

